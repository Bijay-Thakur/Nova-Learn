# Copy to .env.local. Restart the application after changes.
# Never commit .env.local or share service-role/provider keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Future local model: OpenAI-compatible chat completions + JSON mode.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=llama3.1

# Optional task-aware routes. Blank values inherit the UI provider selection.
NOVA_DRAFT_PROVIDER=
NOVA_DRAFT_MODEL=
NOVA_DIALOGUE_PROVIDER=
NOVA_DIALOGUE_MODEL=
NOVA_JUDGE_PROVIDER=
NOVA_JUDGE_MODEL=

# Optional semantic retrieval; otherwise approved sources use keyword search.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Defaults to OpenAI when blank. Can use a compatible hosted/local voice server.
VOICE_BASE_URL=
VOICE_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=nova
